{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/huawei-cup/supporting-materials.schema.json",
  "title": "华为杯提交附件支撑材料清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_title",
    "package_status",
    "questions",
    "external_data",
    "external_data_note",
    "official_outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_title": {"type": "string", "minLength": 1},
    "package_status": {"enum": ["draft", "complete"]},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "external_data": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalData"}
    },
    "external_data_note": {
      "type": "string",
      "minLength": 1
    },
    "official_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/officialOutput"}
    }
  },
  "$defs": {
    "fileItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "runVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "record_path", "verified_at"],
      "properties": {
        "status": {"enum": ["pending", "pass", "fail"]},
        "command": {"type": "string", "minLength": 1},
        "record_path": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string"}
      }
    },
    "supplementaryMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "material_type", "description", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "material_type": {"enum": ["figure", "table"]},
        "description": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "title",
        "status",
        "entrypoint",
        "run_command",
        "source_files",
        "run_verification",
        "supplementary_materials",
        "supplementary_materials_note"
      ],
      "properties": {
        "question_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "complete"]},
        "entrypoint": {"type": "string", "minLength": 1},
        "run_command": {"type": "string", "minLength": 1},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileItem"}
        },
        "run_verification": {"$ref": "#/$defs/runVerification"},
        "supplementary_materials": {
          "type": "array",
          "items": {"$ref": "#/$defs/supplementaryMaterial"}
        },
        "supplementary_materials_note": {"type": "string", "minLength": 1}
      }
    },
    "externalData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_id",
        "name",
        "description",
        "source",
        "accessed_at",
        "collection_method",
        "license_or_terms",
        "used_by",
        "files",
        "collection_scripts",
        "provenance_file"
      ],
      "properties": {
        "data_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "minLength": 1},
        "collection_method": {"type": "string", "minLength": 1},
        "license_or_terms": {"type": "string", "minLength": 1},
        "used_by": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileItem"}
        },
        "collection_scripts": {
          "type": "array",
          "items": {"$ref": "#/$defs/fileItem"}
        },
        "provenance_file": {"type": "string", "minLength": 1}
      }
    },
    "officialOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description", "verification_path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "verification_path": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "pass", "fail"]}
      }
    }
  }
}
