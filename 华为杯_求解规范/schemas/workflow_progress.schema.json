{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/workflow_progress.schema.json",
  "title": "MathMode workflow_progress 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "questions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "main_run",
          "baseline_run",
          "validation",
          "evidence"
        ],
        "properties": {
          "main_run": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_run": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "validation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_main_spec": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_baseline_spec": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "repair_activation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
