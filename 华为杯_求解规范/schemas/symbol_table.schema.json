{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/symbol_table.schema.json",
  "title": "MathMode symbol_table 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbols"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol_id",
          "symbol",
          "meaning",
          "unit",
          "dimensions",
          "code_name",
          "domain",
          "question_ids"
        ],
        "properties": {
          "symbol_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "code_name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "lower",
              "upper"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "real",
                  "integer",
                  "boolean"
                ]
              },
              "lower": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "upper": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
