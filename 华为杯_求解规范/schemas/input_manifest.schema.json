{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/input_manifest.schema.json",
  "title": "MathMode input_manifest 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "created_at",
    "producer",
    "frozen",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "frozen": {
      "const": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "path",
          "role",
          "sha256",
          "size_bytes",
          "source",
          "readonly"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "role": {
            "enum": [
              "problem",
              "data",
              "template",
              "rule",
              "description"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "accessed_at",
              "license"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "accessed_at": {
                "type": "string",
                "format": "date-time"
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "readonly": {
            "const": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
