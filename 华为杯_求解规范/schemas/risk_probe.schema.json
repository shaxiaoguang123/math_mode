{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/risk_probe.schema.json",
  "title": "MathMode risk_probe 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "method_id",
    "run_id",
    "checks",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "status",
          "evidence_refs",
          "metrics",
          "thresholds",
          "reason"
        ],
        "properties": {
          "category": {
            "enum": [
              "executability",
              "coverage",
              "assumptions",
              "degeneracy",
              "perturbation",
              "scale"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "thresholds": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 6,
      "uniqueItems": false
    },
    "verdict": {
      "enum": [
        "PASS",
        "CONDITIONAL",
        "FAIL"
      ]
    }
  }
}
