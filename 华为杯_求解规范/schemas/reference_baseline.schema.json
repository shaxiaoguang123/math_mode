{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/reference_baseline.schema.json",
  "title": "MathMode reference_baseline 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "case_id",
    "question_id",
    "freeze_id",
    "created_at",
    "framer_task",
    "writer_task",
    "artifacts",
    "scope",
    "paper_acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "freeze_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "framer_task": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "writer_task": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "models",
        "code",
        "results",
        "paper"
      ],
      "properties": {
        "frame": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "path",
              "sha256"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "path",
              "sha256"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "code": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "path",
              "sha256"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "path",
              "sha256"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "paper": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_path",
              "path",
              "sha256"
            ],
            "properties": {
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": false
        }
      }
    },
    "scope": {
      "const": "host_observed_pre_reference_baseline"
    },
    "paper_acceptance": {
      "const": "NOT_RUN"
    }
  }
}
