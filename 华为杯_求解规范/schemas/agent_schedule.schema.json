{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/agent_schedule.schema.json",
  "title": "MathMode agent_schedule 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "question_dag",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "question_dag": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "nodes"
          ],
          "properties": {
            "schema_version": {
              "const": "2.0"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "depends_on"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": false
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "actor_id",
          "role",
          "question_id",
          "instructions",
          "inputs",
          "outputs",
          "reviewed_actor_id",
          "view",
          "depends_on",
          "attempt",
          "supersedes_task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "actor_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "role": {
            "enum": [
              "framer",
              "ambiguity",
              "data_auditor",
              "method_retriever",
              "council",
              "critic",
              "probe",
              "decision",
              "code",
              "validator",
              "reviewer",
              "visual",
              "writer"
            ]
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "contract",
                "format"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
                },
                "contract": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "format": {
                  "enum": [
                    "json",
                    "jsonl",
                    "python",
                    "tex"
                  ]
                }
              }
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "reviewed_actor_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "view": {
            "anyOf": [
              {
                "enum": [
                  "mechanism",
                  "statistics",
                  "optimization",
                  "engineering",
                  "innovation"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "supersedes_task_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
