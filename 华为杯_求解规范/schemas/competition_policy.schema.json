{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/competition_policy.schema.json",
  "title": "MathMode competition policy 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "competition", "year", "edition", "verification", "official_sources", "official_template_path", "official_template_sha256", "official", "project_recommendations"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "competition": {"$ref": "#/$defs/text"},
    "year": {"type": ["integer", "null"], "minimum": 1980, "maximum": 2200},
    "edition": {"type": "string", "pattern": "^[一二三四五六七八九十百零〇两0-9]{1,12}$"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "note"],
      "properties": {
        "status": {"enum": ["unverified", "verified"]},
        "reviewed_by": {"type": ["string", "null"], "minLength": 1},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "note": {"$ref": "#/$defs/text"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"reviewed_by": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}}}]
    },
    "official_sources": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "url", "authority", "checked_at", "snapshot_path", "sha256", "scope"],
        "properties": {
          "source_id": {"$ref": "#/$defs/text"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "authority": {"$ref": "#/$defs/text"},
          "checked_at": {"type": "string", "format": "date-time"},
          "snapshot_path": {"$ref": "#/$defs/text"},
          "sha256": {"$ref": "#/$defs/hash"},
          "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "official_template_path": {"type": ["string", "null"], "minLength": 1},
    "official_template_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "official": {
      "type": "object", "additionalProperties": false,
      "required": ["cover_policy", "anonymity_policy", "abstract_policy", "toc_policy", "page_policy", "reference_policy", "ai_policy", "attachment_policy", "submission_policy"],
      "properties": {
        "cover_policy": {
          "type": "object", "additionalProperties": false, "required": ["mode", "pages"],
          "properties": {"mode": {"enum": ["title_only", "identity_cover", "none"]}, "pages": {"type": "integer", "minimum": 0, "maximum": 10}}
        },
        "anonymity_policy": {
          "type": "object", "additionalProperties": false, "required": ["scope", "identity_terms"],
          "properties": {"scope": {"enum": ["all", "after_cover", "none"]}, "identity_terms": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}
        },
        "abstract_policy": {
          "type": "object", "additionalProperties": false, "required": ["max_pages"],
          "properties": {"max_pages": {"$ref": "#/$defs/page_limit"}}
        },
        "toc_policy": {
          "type": "object", "additionalProperties": false, "required": ["mode", "depth"],
          "properties": {"mode": {"enum": ["required", "optional", "forbidden"]}, "depth": {"type": "integer", "minimum": 1, "maximum": 3}}
        },
        "page_policy": {
          "type": "object", "additionalProperties": false, "required": ["min_body_pages", "max_total_pages", "body_definition"],
          "properties": {"min_body_pages": {"$ref": "#/$defs/page_limit"}, "max_total_pages": {"$ref": "#/$defs/page_limit"}, "body_definition": {"const": "first_body_heading_to_before_references_or_appendix"}}
        },
        "reference_policy": {"$ref": "#/$defs/rules"},
        "ai_policy": {"$ref": "#/$defs/rules"},
        "attachment_policy": {"$ref": "#/$defs/rules"},
        "submission_policy": {"$ref": "#/$defs/rules"}
      }
    },
    "project_recommendations": {
      "type": "object", "additionalProperties": false, "required": ["include_toc", "note"],
      "properties": {"include_toc": {"type": "boolean"}, "note": {"$ref": "#/$defs/text"}}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "page_limit": {"type": ["integer", "null"], "minimum": 1},
    "rules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
