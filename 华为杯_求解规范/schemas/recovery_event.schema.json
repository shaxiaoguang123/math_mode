{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/recovery_event.schema.json",
  "title": "MathMode recovery_event 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "kind",
    "status",
    "recovered_at",
    "reason",
    "evidence",
    "attempt",
    "returncode",
    "process_observation",
    "descendant_quiescence",
    "scientific_acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "kind": {
      "enum": [
        "run",
        "agent"
      ]
    },
    "status": {
      "const": "ABANDONED"
    },
    "recovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 2,
      "uniqueItems": false
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "returncode": {
      "type": "null"
    },
    "process_observation": {
      "enum": [
        "recorded_owner_and_child_stopped",
        "owner_stopped_execution_not_started"
      ]
    },
    "descendant_quiescence": {
      "const": "NOT_PROVEN"
    },
    "scientific_acceptance": {
      "const": "NOT_RUN"
    }
  }
}
