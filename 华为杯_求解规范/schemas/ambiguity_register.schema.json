{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/ambiguity_register.schema.json",
  "title": "MathMode ambiguity_register 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_by",
    "reviewed_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ambiguity_id",
          "severity",
          "source",
          "issue",
          "interpretations",
          "question_ids",
          "status",
          "resolution",
          "evidence_refs"
        ],
        "properties": {
          "ambiguity_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "interpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 2,
            "uniqueItems": false
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "unresolved",
              "resolved",
              "mitigated"
            ]
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": false
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    }
  }
}
