{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/run_manifest.schema.json",
  "title": "MathMode run_manifest 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "question_id",
    "method_id",
    "role",
    "producer",
    "actor_id",
    "backend",
    "capabilities",
    "interpreter",
    "argv",
    "cwd",
    "environment",
    "seed",
    "started_at",
    "ended_at",
    "duration_seconds",
    "timeout_seconds",
    "returncode",
    "timed_out",
    "status",
    "failure_class",
    "cause_id",
    "failure_message",
    "attempt",
    "retry_of",
    "spec",
    "input_manifest_sha256",
    "inputs",
    "code",
    "outputs",
    "logs",
    "control_files",
    "scientific_acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "role": {
      "enum": [
        "main",
        "baseline",
        "probe",
        "validator",
        "fallback"
      ]
    },
    "producer": {
      "const": "runner"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_sandbox",
        "network_isolation",
        "filesystem_isolation",
        "memory_limit",
        "cpu_limit",
        "timeout",
        "process_tree_termination"
      ],
      "properties": {
        "os_sandbox": {
          "type": "boolean"
        },
        "network_isolation": {
          "type": "boolean"
        },
        "filesystem_isolation": {
          "type": "boolean"
        },
        "memory_limit": {
          "type": "boolean"
        },
        "cpu_limit": {
          "type": "boolean"
        },
        "timeout": {
          "type": "boolean"
        },
        "process_tree_termination": {
          "enum": [
            "best_effort",
            "enforced",
            "unsupported"
          ]
        }
      }
    },
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "executable",
        "sha256",
        "version",
        "platform",
        "packages"
      ],
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "returncode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "timed_out": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "failure_class": {
      "anyOf": [
        {
          "enum": [
            "ENV_FAILURE",
            "DATA_FAILURE",
            "CODE_FAILURE",
            "MODEL_FAILURE",
            "VALIDATION_FAILURE",
            "POLICY_FAILURE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cause_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_authorization": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "review",
            "candidate_spec",
            "execution_role",
            "retry_of"
          ],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "candidate_spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "execution_role": {
              "enum": [
                "main",
                "baseline",
                "fallback",
                "probe"
              ]
            },
            "retry_of": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "snapshot_path",
        "sha256"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "source_path",
          "snapshot_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "snapshot_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "stderr"
      ],
      "properties": {
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stderr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "control_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "contract_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "source_path",
          "snapshot_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "contract": {
            "enum": [
              "validation_criteria",
              "risk_probe_plan",
              "method_card",
              "risk_probe",
              "run_manifest",
              "assumption_plan"
            ]
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "upstream_freezes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "freeze_id",
          "source_path",
          "snapshot_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "freeze_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "scientific_acceptance": {
      "const": "NOT_RUN"
    }
  }
}
