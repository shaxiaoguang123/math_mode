{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/problem_dag.schema.json",
  "title": "MathMode problem_dag 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "depends_on"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
