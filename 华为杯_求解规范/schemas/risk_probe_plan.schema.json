{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/risk_probe_plan.schema.json",
  "title": "MathMode risk_probe_plan 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "method_id",
    "actor_id",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "not_applicable_reason",
          "measurements",
          "reason"
        ],
        "properties": {
          "category": {
            "enum": [
              "executability",
              "coverage",
              "assumptions",
              "degeneracy",
              "perturbation",
              "scale"
            ]
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "output_name",
                "locator",
                "operator",
                "threshold"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                },
                "output_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "operator": {
                  "enum": [
                    "le",
                    "ge",
                    "eq"
                  ]
                },
                "threshold": {
                  "type": "number"
                }
              }
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 6,
      "uniqueItems": false
    }
  }
}
