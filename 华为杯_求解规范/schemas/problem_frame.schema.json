{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/problem_frame.schema.json",
  "title": "MathMode problem_frame 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "producer",
    "source_refs",
    "data_audit_ref",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "data_audit_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "title",
          "task_type",
          "inputs",
          "outputs",
          "objective",
          "constraints",
          "source_refs",
          "resources"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "task_type": {
            "enum": [
              "regression",
              "optimization",
              "time_series",
              "mechanism",
              "simulation",
              "graph",
              "classification",
              "decision"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "path",
                "format",
                "fields",
                "precision"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:).+$"
                },
                "format": {
                  "enum": [
                    "json",
                    "csv",
                    "xlsx",
                    "txt"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "type",
                      "unit"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "type": {
                        "enum": [
                          "number",
                          "integer",
                          "string",
                          "boolean"
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "minItems": 1,
                  "uniqueItems": false
                },
                "precision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                }
              }
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "objective": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "metric",
              "sense"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sense": {
                "enum": [
                  "min",
                  "max",
                  "match",
                  "explain"
                ]
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "constraint_id",
                "expression",
                "unit",
                "source_ref",
                "validator",
                "tolerance"
              ],
              "properties": {
                "constraint_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "validator": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "minItems": 0,
            "uniqueItems": false
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_seconds",
              "memory_mb"
            ],
            "properties": {
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "memory_mb": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "minItems": 1,
      "uniqueItems": false
    }
  }
}
