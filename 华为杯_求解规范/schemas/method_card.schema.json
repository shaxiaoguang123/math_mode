{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmode.local/schemas/method_card.schema.json",
  "title": "MathMode method_card 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "methods",
    "critic"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "role",
          "idea",
          "completes_task",
          "outputs",
          "assumption_ids",
          "source_refs",
          "cost",
          "fallback_trigger",
          "validation_plan",
          "rejection_reason"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "role": {
            "enum": [
              "main_candidate",
              "usable_baseline",
              "conditional_fallback",
              "diagnostic_reference"
            ]
          },
          "idea": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "completes_task": {
            "type": "boolean"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "assumption_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeout_seconds",
              "memory_mb"
            ],
            "properties": {
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "memory_mb": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "fallback_trigger": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "metric",
                  "operator",
                  "threshold"
                ],
                "properties": {
                  "metric": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "operator": {
                    "enum": [
                      "gt",
                      "ge",
                      "lt",
                      "le",
                      "eq"
                    ]
                  },
                  "threshold": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "validation_plan": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": false
          },
          "rejection_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 2,
      "uniqueItems": false
    },
    "critic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "findings",
        "evidence_refs"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": false
        }
      }
    }
  }
}
